# ── Appointment email delivery (Resend) ─────────────────────────────
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where appointment notifications are delivered (reception / management)
APPOINTMENT_TO_EMAIL=dulaarhospital@outlook.com

# Verified sender. In production use a verified domain address,
# e.g. "Dulaar Hospital <appointments@dulaarhospital.com>".
# Until a domain is verified, Resend's test sender works for testing:
APPOINTMENT_FROM_EMAIL="Dulaar Hospital <onboarding@resend.dev>"
